{
  "name": "lingoglass",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/sync-content.mjs --build && node scripts/validate-content.mjs && node scripts/precompute-ja.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "typecheck:workers": "tsc --noEmit -p functions/tsconfig.json",
    "dev:admin": "wrangler pages dev out --port 8788",
    "lint": "eslint .",
    "test": "vitest run",
    "audio:generate": "node scripts/generate-audio.mjs",
    "audio:fixture": "node scripts/generate-audio.mjs --fixture",
    "audio:clear": "node scripts/clear-audio.mjs",
    "audio:reconcile": "node scripts/audio-reconcile.mjs",
    "deploy": "wrangler pages deploy out --project-name=lingoglass --commit-dirty=true",
    "db:migrate": "wrangler d1 migrations apply lingoglasse-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply lingoglasse-db --local",
    "db:list": "wrangler d1 migrations list lingoglasse-db --remote",
    "admin:create": "node scripts/admin-create.mjs",
    "content:import": "node scripts/import-content.mjs",
    "content:sync": "node scripts/sync-content.mjs",
    "publish": "node scripts/publish.mjs"
  },
  "dependencies": {
    "next": "15.5.26",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "typescript": "^5.7.3",
    "vitest": "5.0.1"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
