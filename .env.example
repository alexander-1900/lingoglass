# Japanese tokens are PRECOMPUTED at build time (scripts/precompute-ja.mjs runs
# on prebuild) into data/ja-tokens.generated.json, which is COMMITTED — deploy
# machines (Cloudflare/Netlify) never need Python. Python/Sudachi is only used
# LOCALLY at build time to regenerate that file. Install its deps once (see
# services/sudachi/requirements.txt); set PYTHON if your interpreter is not on
# PATH as `python`/`python3`.
# PYTHON=C:\\Python314\\python.exe

# Google sign-in (Auth.js v5). Create an OAuth client in Google Cloud Console
# with redirect URI http://localhost:3000/api/auth/callback/google (+ your
# production URL). WITHOUT these vars the app builds and runs exactly as
# before — the sign-in button is hidden, no request is ever made.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Required in production for session encryption (generate: openssl rand -base64 32)
AUTH_SECRET=

# Sync database (Drizzle + Turso/libSQL). Local dev needs NOTHING — it falls
# back to file:lingoglass.db (gitignored). Production sets a remote libsql://
# URL + token. WITHOUT a database, /api/sync answers 503 and everything stays
# localStorage-only, even when signed in.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: canonical URL used for absolute links in sitemap.xml
SITE_URL=http://localhost:3000
